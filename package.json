{
  "name": "eichmannimmobilien",
  "private": true,
  "type": "module",
  "description": "Static site for Immobilien Eichmann – Immowelt listings sync",
  "scripts": {
    "sync-immowelt": "node scripts/sync-immowelt.mjs",
    "sync-immowelt:render": "node scripts/sync-immowelt.mjs --render-only",
    "sync-immowelt:seed": "node scripts/sync-immowelt.mjs --from-json ../eichmann-logo/listings.json",
    "test:logo": "node scripts/test-logo-consistency.mjs",
    "test:layout": "node scripts/test-layout-regression.mjs",
    "build:share": "node scripts/build-share-card.mjs",
    "test:share": "node scripts/test-share-card.mjs",
    "test": "npm run test:sot && npm run test:share && npm run test:logo && npm run test:jsonld && npm run test:legal && npm run test:content && npm run test:layout && npm run test:ai-index && npm run test:mcp && npm run test:ga4-funnel && npm run test:ab-ga4 && npm run test:dev-checklist && npm run test:claude-v2 && npm run test:claude-final",
    "test:strict": "npm run test:legal && STRICT=1 npm run test:logo && STRICT=1 npm run test:layout",
    "test:jsonld": "node scripts/test-jsonld.mjs",
    "test:legal": "node scripts/test-legal-baseline.mjs",
    "test:expose-form": "node scripts/test-expose-form.mjs",
    "test:content": "node scripts/test-listing-content.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:bootstrap": "node scripts/db-migrate.mjs --bootstrap",
    "publish:db": "node scripts/publish-from-db.mjs",
    "test:eigen-survives": "node scripts/test-eigen-survives-sync.mjs",
    "test:immowelt-reason": "node scripts/test-immowelt-public-reason.mjs",
    "admin-api": "node scripts/admin-api.mjs",
    "test:immowelt-secrets": "node scripts/test-immowelt-secrets.mjs",
    "test:immowelt-api": "node scripts/test-immowelt-official-api.mjs",
    "test:admin-password": "node scripts/test-admin-password.mjs",
    "ai:index": "node scripts/build-ai-index.mjs",
    "test:ai-index": "node scripts/test-ai-index.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "test:mcp": "node scripts/test-mcp-server.mjs",
    "test:ga4-funnel": "node scripts/test-ga4-funnel.mjs",
    "test:ab-ga4": "node scripts/test-ab-ga4.mjs",
    "test:dev-checklist": "node scripts/test-dev-checklist-ga4.mjs",
    "test:claude-v2": "node scripts/test-claude-v2.mjs",
    "build:en": "node scripts/build-en-pages.mjs",
    "test:claude-final": "node scripts/test-claude-final.mjs",
    "verify:mirror": "node scripts/verify-listings-mirror.mjs",
    "build": "node scripts/build.mjs",
    "sot:validate": "node scripts/validate-sot.mjs",
    "sot:check": "node scripts/check-output.mjs",
    "sot": "node scripts/sot-cli.mjs",
    "test:sot": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "playwright": "^1.49.0",
    "sharp": "^0.33.5"
  }
}
