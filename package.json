{
  "name": "eichmannimmobilien",
  "private": true,
  "type": "module",
  "description": "Static site for Immobilien Eichmann \u2013 Immowelt listings sync",
  "scripts": {
    "sync-immowelt": "node scripts/sync-immowelt.mjs",
    "sync-immowelt:render": "node scripts/sync-immowelt.mjs --render-only",
    "sync-immowelt:seed": "node scripts/sync-immowelt.mjs --from-json ../eichmann-logo/listings.json",
    "test:logo": "node scripts/test-logo-consistency.mjs",
    "test:layout": "node scripts/test-layout-regression.mjs",
    "build:share": "node scripts/build-share-card.mjs",
    "test:share": "node scripts/test-share-card.mjs",
    "test": "npm run test:share && npm run test:logo && npm run test:jsonld && npm run test:legal && npm run test:content && npm run test:layout",
    "test:strict": "npm run test:legal && STRICT=1 npm run test:logo && STRICT=1 npm run test:layout",
    "test:jsonld": "node scripts/test-jsonld.mjs",
    "test:legal": "node scripts/test-legal-baseline.mjs",
    "test:expose-form": "node scripts/test-expose-form.mjs",
    "test:content": "node scripts/test-listing-content.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:bootstrap": "node scripts/db-migrate.mjs --bootstrap",
    "publish:db": "node scripts/publish-from-db.mjs",
    "test:eigen-survives": "node scripts/test-eigen-survives-sync.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "playwright": "^1.49.0",
    "sharp": "^0.33.5"
  }
}
